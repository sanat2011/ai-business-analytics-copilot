# Local development only — never commit real secrets.
# Copy to .env and fill in values, or use .streamlit/secrets.toml

# Snowflake connection
# Account identifier = org-account (hyphen), e.g. OSBBDNY-LKB20395
SNOWFLAKE_ACCOUNT=OSBBDNY-LKB20395
SNOWFLAKE_USER=SANAT2011

# Auth: password (student accounts) OR externalbrowser (only if SSO/SAML is configured)
# Student trial tip: externalbrowser often fails with SAML IdP errors — use password.
SNOWFLAKE_AUTHENTICATOR=password
# Only needed when SNOWFLAKE_AUTHENTICATOR=password
SNOWFLAKE_PASSWORD=

# For first-time DDL/load use ACCOUNTADMIN. Later switch app to ANALYTICS_AI_READONLY.
SNOWFLAKE_ROLE=ACCOUNTADMIN
# Trial accounts usually have COMPUTE_WH — run SHOW WAREHOUSES; in Snowsight to confirm
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ANALYTICS_AI_DB
SNOWFLAKE_SCHEMA=ANALYTICS

# Optional: private-key auth (preferred over password for automation)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# LLM for SQL generation / insights
# Options: snowflake_cortex | openai
LLM_PROVIDER=snowflake_cortex
CORTEX_MODEL=mistral-large
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Loader settings (use ACCOUNTADMIN until sql/roles.sql is applied)
SNOWFLAKE_LOAD_ROLE=ACCOUNTADMIN
SNOWFLAKE_STAGE=ANALYTICS_AI_DB.RAW.SUPERSTORE_STAGE
